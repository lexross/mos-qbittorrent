
{
  "name": "qBittorrent",
  "repo": "lscr.io/linuxserver/qbittorrent:latest",
  "category": ["downloader"],
  "registry": null,
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/qbittorrent.png",
  "project": "https://github.com/linuxserver/docker-qbittorrent",
  "support": null,
  "description": "qBittorrent is a BitTorrent client with a web interface.",
  "paths": [
    {
      "name": "Configuration",
      "host": "/mnt/cache/appdata/qbittorrent",
      "container": "/config",
      "mode": "rw",
      "description": "Configuration et données de qBittorrent.",
      "required": true
    },
    {
      "name": "Téléchargements",
      "host": "/mnt/cache/downloads",
      "container": "/downloads",
      "mode": "rw",
      "description": "Dossier destiné aux téléchargements de test.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Interface Web",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Interface Web de qBittorrent.",
      "required": true,
      "mask": false
    },
    {
      "name": "BitTorrent TCP",
      "host": "6881",
      "container": "6881",
      "protocol": "tcp",
      "description": "Connexions BitTorrent entrantes.",
      "required": true,
      "mask": false
    },
    {
      "name": "BitTorrent UDP",
      "host": "6881",
      "container": "6881",
      "protocol": "udp",
      "description": "Trafic BitTorrent UDP.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Identifiant utilisateur à vérifier avant le déploiement.",
      "required": true,
      "mask": false
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Identifiant groupe à vérifier avant le déploiement.",
      "required": true,
      "mask": false
    },
    {
      "name": "TZ",
      "key": "TZ",
      "value": "America/Toronto",
      "description": "Fuseau horaire.",
      "required": true,
      "mask": false
    },
    {
      "name": "WEBUI_PORT",
      "key": "WEBUI_PORT",
      "value": "8080",
      "description": "Port de l'interface Web.",
      "required": true,
      "mask": false
    },
    {
      "name": "TORRENTING_PORT",
      "key": "TORRENTING_PORT",
      "value": "6881",
      "description": "Port des connexions BitTorrent.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
